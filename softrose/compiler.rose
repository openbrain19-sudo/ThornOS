# SoftRose compiler - written in SoftRose
# single-pass compiler, full language support

task start() {
    write("SoftRose v0.1\n")
    src = "task start write hello world end"
    len = 31
    asm = compile_src(src, len)
    write(asm)
    write("done\n")
}

task compile_src(src, len) {
    out = "module data\n    msg hello world\n\nmodule reserve\n    _stack 16384\n\nmodule code\n"
    pos = 0
    fn_count = 0
    loop(pos < len) {
        if (match_kw(src, pos, "task")) {
            pos = pos + 4
            pos = skip_ws(src, pos, len)
            ns = pos
            ne = word_end(src, pos, len)
            fname = sub(src, ns, ne)
            pos = ne
            pos = skip_ws(src, pos, len)
            if (pos < len && src[pos] == 40) {
                pos = pos + 1
                loop(pos < len && src[pos] != 41) { pos = pos + 1 }
                pos = pos + 1
            }
            pos = skip_ws(src, pos, len)
            if (pos < len && src[pos] == 123) {
                pos = pos + 1
                bs = pos
                depth = 1
                loop(depth > 0 && pos < len) {
                    if (src[pos] == 123) { depth = depth + 1 }
                    if (src[pos] == 125) { depth = depth - 1 }
                    pos = pos + 1
                }
                be = pos - 1
                ctx = "fn"
                lc = 0
                out = out + "\n    fn global " + fname + "\n    start\n        push sbp\n        move sbp stp\n"
                out = out + compile_block(src, bs, be, ctx, lc)
                out = out + "        move ret 0\n        move stp sbp\n        pop sbp\n        return\n    end\n"
                fn_count = fn_count + 1
            }
        } else {
            pos = pos + 1
        }
    }
    out = out + "\n    fn global _start\n    start\n        call start\n        move ret 0\n        syscall\n    end\n"
    send out
}

task compile_block(src, bs, be, ctx, lc) {
    out = ""
    bp = bs
    loop(bp < be) {
        ch = src[bp]
        if (ch == 10 || ch == 32 || ch == 9) { bp = bp + 1; continue }
        if (ch == 35) { loop(bp < be && src[bp] != 10) { bp = bp + 1 }; continue }
        # write("string") or write(v"string {expr}")
        if (match_kw(src, bp, "write(")) {
            p = bp + 6
            loop(p < be && src[p] != 41) { p = p + 1 }
            if (p < be && src[p] == 41) {
                inner = sub(src, bp + 6, p)
                sl = slen(inner)
                if (sl > 1 && inner[0] == 34) {
                    # plain string
                    out = out + "        lma ret msg\n        move dst 1\n        move src ret\n        move dta " + num_str(sl - 2) + "\n        move ret 1\n        syscall\n"
                } elif (sl > 1 && inner[0] == 118 && inner[1] == 34) {
                    # v-string - output each char/expr separately
                    out = out + compile_vstring(inner, sl)
                } elif (sl > 0 && inner[0] >= 97 && inner[0] <= 122) {
                    # variable
                    out = out + "        move ret [" + inner + "]\n        move dst 1\n        move src ret\n        move dta 1\n        move ret 1\n        syscall\n"
                }
                bp = p + 1
            }
            continue
        }
        # send expr
        if (match_kw(src, bp, "send ")) {
            bp = bp + 5
            ev = eval_expr(src, bp, be, lc)
            out = out + ev
            bp = eol(src, bp, be)
            continue
        }
        # risk { }
        if (match_kw(src, bp, "risk")) {
            bp = bp + 4
            bp = skip_ws(src, bp, be)
            if (bp < be && src[bp] == 123) {
                bp = bp + 1
                rbs = bp
                depth = 1
                loop(depth > 0 && bp < be) {
                    if (src[bp] == 123) { depth = depth + 1 }
                    if (src[bp] == 125) { depth = depth - 1 }
                    bp = bp + 1
                }
                rbe = bp - 1
                out = out + compile_block(src, rbs, rbe, ctx, lc)
            }
            continue
        }
        # try { } catch(e) { }
        if (match_kw(src, bp, "try")) {
            bp = bp + 3
            bp = skip_ws(src, bp, be)
            if (bp < be && src[bp] == 123) {
                bp = bp + 1
                tbs = bp
                depth = 1
                loop(depth > 0 && bp < be) {
                    if (src[bp] == 123) { depth = depth + 1 }
                    if (src[bp] == 125) { depth = depth - 1 }
                    bp = bp + 1
                }
                tbe = bp - 1
                out = out + compile_block(src, tbs, tbe, ctx, lc)
            }
            bp = skip_ws(src, bp, be)
            if (match_kw(src, bp, "catch")) {
                bp = bp + 5
                bp = skip_ws(src, bp, be)
                if (bp < be && src[bp] == 40) {
                    bp = bp + 1
                    loop(bp < be && src[bp] != 41) { bp = bp + 1 }
                    bp = bp + 1
                }
                bp = skip_ws(src, bp, be)
                if (bp < be && src[bp] == 123) {
                    bp = bp + 1
                    cbs = bp
                    depth = 1
                    loop(depth > 0 && bp < be) {
                        if (src[bp] == 123) { depth = depth + 1 }
                        if (src[bp] == 125) { depth = depth - 1 }
                        bp = bp + 1
                    }
                    cbe = bp - 1
                    out = out + compile_block(src, cbs, cbe, ctx, lc)
                }
            }
            continue
        }
        # spawn(task(args))
        if (match_kw(src, bp, "spawn(")) {
            p = bp + 6
            loop(p < be && src[p] != 41) { p = p + 1 }
            inner = sub(src, bp + 6, p)
            out = out + "        call " + inner + "\n"
            bp = p + 1
            continue
        }
        # section
        if (match_kw(src, bp, "section")) {
            bp = bp + 7
            loop(bp < be && src[bp] != 123) { bp = bp + 1 }
            if (bp < be && src[bp] == 123) {
                bp = bp + 1
                depth = 1
                loop(depth > 0 && bp < be) {
                    if (src[bp] == 123) { depth = depth + 1 }
                    if (src[bp] == 125) { depth = depth - 1 }
                    bp = bp + 1
                }
            }
            continue
        }
        # need
        if (match_kw(src, bp, "need")) {
            bp = bp + 4
            loop(bp < be && src[bp] != 10) { bp = bp + 1 }
            continue
        }
        # if (cond) { ... } elif (...) { ... } else { ... }
        if (match_kw(src, bp, "if")) {
            result = compile_if(src, bp, be, ctx, lc)
            out = out + result
            bp = find_endif(src, bp, be)
            continue
        }
        # loop(on) / loop(n) / loop(i = n) / loop(cond) { ... }
        if (match_kw(src, bp, "loop")) {
            result = compile_loop(src, bp, be, ctx, lc)
            out = out + result
            bp = find_loopend(src, bp, be)
            continue
        }
        # variable = expr
        eq = find_ch(src, bp, be, 61)
        if (eq > bp && eq < be && src[eq + 1] != 61) {
            vn = sub(src, bp, eq)
            vs = eq + 1
            ve = eol(src, vs, be)
            out = out + eval_expr(src, vs, ve, lc)
            out = out + "        move [" + vn + "] ret\n"
            bp = ve + 1
            continue
        }
        bp = bp + 1
    }
    send out
}

task compile_if(src, pos, be, ctx, lc) {
    out = ""
    pos = pos + 2
    pos = skip_ws(src, pos, be)
    if (pos < be && src[pos] == 40) {
        pos = pos + 1
        cs = pos
        depth = 1
        loop(pos < be && depth > 0) {
            if (src[pos] == 40) { depth = depth + 1 }
            if (src[pos] == 41) { depth = depth - 1 }
            pos = pos + 1
        }
        ce = pos - 1
        lc = lc + 1
        lbl = num_str(lc)
        out = out + eval_expr(src, cs, ce, lc)
        out = out + "        cmp ret == 0 go elif_" + lbl + "\n"
        pos = skip_ws(src, pos, be)
        if (pos < be && src[pos] == 123) {
            pos = pos + 1
            ibs = pos
            depth = 1
            loop(depth > 0 && pos < be) {
                if (src[pos] == 123) { depth = depth + 1 }
                if (src[pos] == 125) { depth = depth - 1 }
                pos = pos + 1
            }
            ibe = pos - 1
            out = out + compile_block(src, ibs, ibe, ctx, lc)
            out = out + "        go endif_" + lbl + "\n"
        }
        pos = skip_ws(src, pos, be)
        # handle elif chains
        loop(match_kw(src, pos, "elif")) {
            out = out + "    elif_" + lbl + ":\n"
            pos = pos + 4
            pos = skip_ws(src, pos, be)
            if (pos < be && src[pos] == 40) {
                pos = pos + 1
                cs = pos
                depth = 1
                loop(pos < be && depth > 0) {
                    if (src[pos] == 40) { depth = depth + 1 }
                    if (src[pos] == 41) { depth = depth - 1 }
                    pos = pos + 1
                }
                ce = pos - 1
                out = out + eval_expr(src, cs, ce, lc)
                out = out + "        cmp ret == 0 go elif_" + lbl + "\n"
                pos = skip_ws(src, pos, be)
                if (pos < be && src[pos] == 123) {
                    pos = pos + 1
                    ebs = pos
                    depth = 1
                    loop(depth > 0 && pos < be) {
                        if (src[pos] == 123) { depth = depth + 1 }
                        if (src[pos] == 125) { depth = depth - 1 }
                        pos = pos + 1
                    }
                    ebe = pos - 1
                    out = out + compile_block(src, ebs, ebe, ctx, lc)
                    out = out + "        go endif_" + lbl + "\n"
                }
                pos = skip_ws(src, pos, be)
            }
        }
        # else
        if (match_kw(src, pos, "else")) {
            out = out + "    elif_" + lbl + ":\n"
            pos = pos + 4
            pos = skip_ws(src, pos, be)
            if (pos < be && src[pos] == 123) {
                pos = pos + 1
                ebs = pos
                depth = 1
                loop(depth > 0 && pos < be) {
                    if (src[pos] == 123) { depth = depth + 1 }
                    if (src[pos] == 125) { depth = depth - 1 }
                    pos = pos + 1
                }
                ebe = pos - 1
                out = out + compile_block(src, ebs, ebe, ctx, lc)
            }
        }
        out = out + "    endif_" + lbl + ":\n"
    }
    send out
}

task compile_loop(src, pos, be, ctx, lc) {
    out = ""
    pos = pos + 4
    pos = skip_ws(src, pos, be)
    if (pos < be && src[pos] == 40) {
        pos = pos + 1
        cs = pos
        depth = 1
        loop(pos < be && depth > 0) {
            if (src[pos] == 40) { depth = depth + 1 }
            if (src[pos] == 41) { depth = depth - 1 }
            pos = pos + 1
        }
        ce = pos - 1
        cond = sub(src, cs, ce)
        lc = lc + 1
        lbl = num_str(lc)
        # loop(on) = forever
        if (cond == "on") {
            out = out + "    loop_" + lbl + ":\n"
            pos = skip_ws(src, pos, be)
            if (pos < be && src[pos] == 123) {
                pos = pos + 1
                lbs = pos
                depth = 1
                loop(depth > 0 && pos < be) {
                    if (src[pos] == 123) { depth = depth + 1 }
                    if (src[pos] == 125) { depth = depth - 1 }
                    pos = pos + 1
                }
                lbe = pos - 1
                out = out + compile_block(src, lbs, lbe, ctx, lc)
                out = out + "        go loop_" + lbl + "\n"
            }
            out = out + "    loop_end_" + lbl + ":\n"
            send out
        }
        # loop(n) = count down
        is_num = 1
        ci = 0
        loop(ci < slen(cond)) {
            if (cond[ci] < 48 || cond[ci] > 57) { is_num = 0; break }
            ci = ci + 1
        }
        if (is_num && slen(cond) > 0) {
            out = out + "        move r1 " + cond + "\n"
            out = out + "    loop_" + lbl + ":\n"
            out = out + "        cmp r1 == 0 go loop_end_" + lbl + "\n"
            pos = skip_ws(src, pos, be)
            if (pos < be && src[pos] == 123) {
                pos = pos + 1
                lbs = pos
                depth = 1
                loop(depth > 0 && pos < be) {
                    if (src[pos] == 123) { depth = depth + 1 }
                    if (src[pos] == 125) { depth = depth - 1 }
                    pos = pos + 1
                }
                lbe = pos - 1
                out = out + compile_block(src, lbs, lbe, ctx, lc)
                out = out + "        dec r1\n"
                out = out + "        go loop_" + lbl + "\n"
            }
            out = out + "    loop_end_" + lbl + ":\n"
            send out
        }
        # loop(i = n) = counter, or loop(cond) = while
        eq = find_ch(src, cs, ce, 61)
        if (eq < ce && src[eq] == 61 && src[eq - 1] != 61) {
            # counter loop: loop(i = n)
            cn = sub(src, cs, eq)
            cv = sub(src, eq + 1, ce)
            out = out + "        move " + cn + " 0\n"
            out = out + "        move r1 " + cv + "\n"
            out = out + "    loop_" + lbl + ":\n"
            out = out + "        move ret " + cn + "\n"
            out = out + "        cmp ret >= r1 go loop_end_" + lbl + "\n"
            pos = skip_ws(src, pos, be)
            if (pos < be && src[pos] == 123) {
                pos = pos + 1
                lbs = pos
                depth = 1
                loop(depth > 0 && pos < be) {
                    if (src[pos] == 123) { depth = depth + 1 }
                    if (src[pos] == 125) { depth = depth - 1 }
                    pos = pos + 1
                }
                lbe = pos - 1
                out = out + compile_block(src, lbs, lbe, ctx, lc)
                out = out + "        inc " + cn + "\n"
                out = out + "        go loop_" + lbl + "\n"
            }
            out = out + "    loop_end_" + lbl + ":\n"
            send out
        }
        # while loop: loop(cond)
        out = out + "    loop_" + lbl + ":\n"
        out = out + eval_expr(src, cs, ce, lc)
        out = out + "        cmp ret == 0 go loop_end_" + lbl + "\n"
        pos = skip_ws(src, pos, be)
        if (pos < be && src[pos] == 123) {
            pos = pos + 1
            lbs = pos
            depth = 1
            loop(depth > 0 && pos < be) {
                if (src[pos] == 123) { depth = depth + 1 }
                if (src[pos] == 125) { depth = depth - 1 }
                pos = pos + 1
            }
            lbe = pos - 1
            out = out + compile_block(src, lbs, lbe, ctx, lc)
            out = out + "        go loop_" + lbl + "\n"
        }
        out = out + "    loop_end_" + lbl + ":\n"
    }
    send out
}

task compile_vstring(inner, sl) {
    out = ""
    # v"hello {name} world" - skip v", then alternate string/expr
    p = 2
    seg = ""
    loop(p < sl - 1) {
        ch = inner[p]
        if (ch == 123) {
            # flush string segment
            if (slen(seg) > 0) {
                out = out + "        lma ret msg\n        move dst 1\n        move src ret\n        move dta " + num_str(slen(seg)) + "\n        move ret 1\n        syscall\n"
                seg = ""
            }
            # compile expression
            p = p + 1
            es = p
            loop(p < sl - 1 && inner[p] != 125) { p = p + 1 }
            out = out + "        # vstring expr\n        move ret 0\n"
            p = p + 1
        } else {
            seg = seg + ch
            p = p + 1
        }
    }
    if (slen(seg) > 0) {
        out = out + "        lma ret msg\n        move dst 1\n        move src ret\n        move dta " + num_str(slen(seg)) + "\n        move ret 1\n        syscall\n"
    }
    send out
}

task eval_expr(src, pos, e, lc) {
    out = ""
    loop(pos < e && src[pos] == 32) { pos = pos + 1 }
    if (pos >= e) { out = out + "        move ret 0\n"; send out }
    ch = src[pos]
    # number
    if (ch >= 48 && ch <= 57) {
        ns = pos
        loop(pos < e && src[pos] >= 48 && src[pos] <= 57) { pos = pos + 1 }
        out = out + "        move ret " + sub(src, ns, pos) + "\n"
        send out
    }
    # string literal
    if (ch == 34) {
        pos = pos + 1
        ss = pos
        loop(pos < e && src[pos] != 34) { pos = pos + 1 }
        out = out + "        lma ret msg\n"
        send out
    }
    # on/off/true/false/void
    if (match_kw(src, pos, "on")) { out = out + "        move ret 1\n"; send out }
    if (match_kw(src, pos, "off")) { out = out + "        move ret 0\n"; send out }
    if (match_kw(src, pos, "true")) { out = out + "        move ret 1\n"; send out }
    if (match_kw(src, pos, "false")) { out = out + "        move ret 0\n"; send out }
    if (match_kw(src, pos, "void")) { out = out + "        move ret 0\n"; send out }
    # logical not
    if (ch == 33) {
        pos = pos + 1
        out = out + eval_expr(src, pos, e, lc)
        out = out + "        cmp ret == 0 go _not_t\n        move ret 0\n        go _not_f\n    _not_t: move ret 1\n    _not_f:\n"
        send out
    }
    # unary minus
    if (ch == 45) {
        pos = pos + 1
        out = out + eval_expr(src, pos, e, lc)
        out = out + "        neg ret\n"
        send out
    }
    # parenthesized
    if (ch == 40) {
        pos = pos + 1
        depth = 1
        ps = pos
        loop(pos < e && depth > 0) {
            if (src[pos] == 40) { depth = depth + 1 }
            if (src[pos] == 41) { depth = depth - 1 }
            pos = pos + 1
        }
        out = out + eval_expr(src, ps, pos - 1, lc)
        send out
    }
    # binary op
    op_pos = find_op(src, pos, e)
    if (op_pos < e) {
        out = out + eval_expr(src, pos, op_pos, lc)
        out = out + "        move r1 ret\n"
        op_len = 1
        if (src[op_pos] == 61 && src[op_pos + 1] == 61) { op_len = 2 }
        if (src[op_pos] == 33 && src[op_pos + 1] == 61) { op_len = 2 }
        if (src[op_pos] == 60 && src[op_pos + 1] == 61) { op_len = 2 }
        if (src[op_pos] == 62 && src[op_pos + 1] == 61) { op_len = 2 }
        if (src[op_pos] == 38 && src[op_pos + 1] == 38) { op_len = 2 }
        if (src[op_pos] == 124 && src[op_pos + 1] == 124) { op_len = 2 }
        out = out + eval_expr(src, op_pos + op_len, e, lc)
        out = out + "        move r2 ret\n"
        out = out + gen_op(sub(src, op_pos, op_pos + op_len))
        send out
    }
    # function call
    if (ch >= 97 && ch <= 122) {
        ns = pos
        loop(pos < e && src[pos] >= 97 && src[pos] <= 122) { pos = pos + 1 }
        fname = sub(src, ns, pos)
        pos = skip_ws(src, pos, e)
        if (pos < e && src[pos] == 40) {
            pos = pos + 1
            loop(pos < e && src[pos] != 41) { pos = pos + 1 }
            pos = pos + 1
            out = out + "        call " + fname + "\n"
            send out
        }
        # variable
        out = out + "        move ret [" + fname + "]\n"
        send out
    }
    out = out + "        move ret 0\n"
    send out
}

task gen_op(op) {
    out = ""
    if (op == "+") { out = out + "        add r1 r2\n        move ret r1\n" }
    if (op == "-") { out = out + "        sub r1 r2\n        move ret r1\n" }
    if (op == "*") { out = out + "        mul r1 r2\n        move ret r1\n" }
    if (op == "/") { out = out + "        move dta 0\n        div r2\n        move ret r1\n" }
    if (op == "%") { out = out + "        move dta 0\n        div r2\n        move ret dta\n" }
    if (op == "==") { out = out + "        cmp r1 == r2 go _ot\n        move ret 0\n        go _of\n    _ot: move ret 1\n    _of:\n" }
    if (op == "!=") { out = out + "        cmp r1 != r2 go _ot\n        move ret 0\n        go _of\n    _ot: move ret 1\n    _of:\n" }
    if (op == "<") { out = out + "        cmp r1 < r2 go _ot\n        move ret 0\n        go _of\n    _ot: move ret 1\n    _of:\n" }
    if (op == ">") { out = out + "        cmp r1 > r2 go _ot\n        move ret 0\n        go _of\n    _ot: move ret 1\n    _of:\n" }
    if (op == "<=") { out = out + "        cmp r1 <= r2 go _ot\n        move ret 0\n        go _of\n    _ot: move ret 1\n    _of:\n" }
    if (op == ">=") { out = out + "        cmp r1 >= r2 go _ot\n        move ret 0\n        go _of\n    _ot: move ret 1\n    _of:\n" }
    if (op == "&&") { out = out + "        and r1 r2\n        move ret r1\n" }
    if (op == "||") { out = out + "        or r1 r2\n        move ret r1\n" }
    send out
}

task find_op(src, pos, e) {
    if (src[pos] == 40) {
        d = 1; pos = pos + 1
        loop(pos < e && d > 0) { if (src[pos] == 40) { d = d + 1 }; if (src[pos] == 41) { d = d - 1 }; pos = pos + 1 }
    } elif (src[pos] == 34) {
        pos = pos + 1; loop(pos < e && src[pos] != 34) { pos = pos + 1 }; pos = pos + 1
    } elif (src[pos] >= 48 && src[pos] <= 57) {
        loop(pos < e && src[pos] >= 48 && src[pos] <= 57) { pos = pos + 1 }
    } elif (src[pos] >= 97 && src[pos] <= 122) {
        loop(pos < e && src[pos] >= 97 && src[pos] <= 122) { pos = pos + 1 }
    }
    loop(pos < e && src[pos] == 32) { pos = pos + 1 }
    if (pos < e) {
        ch = src[pos]
        if (ch == 43 || ch == 45 || ch == 42 || ch == 47 || ch == 37) { send pos }
        if (ch == 61 && pos + 1 < e && src[pos + 1] == 61) { send pos }
        if (ch == 33 && pos + 1 < e && src[pos + 1] == 61) { send pos }
        if (ch == 60 && pos + 1 < e && src[pos + 1] == 61) { send pos }
        if (ch == 62 && pos + 1 < e && src[pos + 1] == 61) { send pos }
        if (ch == 60) { send pos }
        if (ch == 62) { send pos }
        if (ch == 38 && pos + 1 < e && src[pos + 1] == 38) { send pos }
        if (ch == 124 && pos + 1 < e && src[pos + 1] == 124) { send pos }
    }
    send e
}

task find_endif(src, pos, be) {
    depth = 0
    loop(pos < be) {
        if (match_kw(src, pos, "if")) { depth = depth + 1 }
        if (match_kw(src, pos, "else")) {
            if (depth == 0) {
                loop(pos < be && src[pos] != 123) { pos = pos + 1 }
                if (pos < be && src[pos] == 123) {
                    pos = pos + 1
                    d = 1
                    loop(d > 0 && pos < be) {
                        if (src[pos] == 123) { d = d + 1 }
                        if (src[pos] == 125) { d = d - 1 }
                        pos = pos + 1
                    }
                }
                send pos
            }
        }
        if (src[pos] == 10) { pos = pos + 1; continue }
        pos = pos + 1
    }
    send pos
}

task find_loopend(src, pos, be) {
    loop(pos < be && src[pos] != 123) { pos = pos + 1 }
    if (pos < be && src[pos] == 123) {
        pos = pos + 1
        d = 1
        loop(d > 0 && pos < be) {
            if (src[pos] == 123) { d = d + 1 }
            if (src[pos] == 125) { d = d - 1 }
            pos = pos + 1
        }
    }
    send pos
}

task eol(src, pos, be) {
    loop(pos < be) { if (src[pos] == 10) { send pos }; pos = pos + 1 }
    send be
}

task match_kw(src, pos, kw) {
    kl = slen(kw)
    i = 0; ok = 1
    loop(i < kl) {
        if (pos + i >= 31) { ok = 0; break }
        if (src[pos + i] != kw[i]) { ok = 0; break }
        i = i + 1
    }
    send ok
}

task skip_ws(src, pos, len) {
    loop(pos < len) { ch = src[pos]; if (ch == 32 || ch == 9 || ch == 10) { pos = pos + 1 } else { break } }
    send pos
}

task word_end(src, pos, len) {
    loop(pos < len) { ch = src[pos]; if (ch == 32 || ch == 9 || ch == 10 || ch == 40 || ch == 123) { break }; pos = pos + 1 }
    send pos
}

task slen(s) { l = 0; loop(s[l] != 0) { l = l + 1 }; send l }

task sub(s, a, b) { r = ""; i = a; loop(i < b) { r = r + s[i]; i = i + 1 }; send r }

task num_str(n) {
    if (n == 0) { send "0" }
    r = ""
    loop(n > 0) { d = n - (n / 10) * 10; r = chr(48 + d) + r; n = n / 10 }
    send r
}

task find_ch(src, pos, e, target) {
    loop(pos < e) { if (src[pos] == target) { send pos }; pos = pos + 1 }
    send e
}

task chr(c) {
    s = ""
    if (c == 48) { s = "0" } if (c == 49) { s = "1" } if (c == 50) { s = "2" }
    if (c == 51) { s = "3" } if (c == 52) { s = "4" } if (c == 53) { s = "5" }
    if (c == 54) { s = "6" } if (c == 55) { s = "7" } if (c == 56) { s = "8" }
    if (c == 57) { s = "9" }
    send s
}
