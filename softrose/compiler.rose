# SoftRose compiler - written in Thorn
# compiles Thorn source to ThornASM assembly
# bootstrap: compile with python softrose, then it compiles itself

task start() {
    write("SoftRose v0.1 bootstrapped\n")
    source = "task main write hello end"
    len = 25
    tokens = tokenize(source, len)
    asm = generate(tokens)
    write(asm)
    write("bootstrap done\n")
}

task tokenize(source, len) {
    pos = 0
    token_count = 0
    loop(pos < len) {
        ch = source[pos]
        if (ch == 32) {
            pos = pos + 1
        } else {
            token_count = token_count + 1
            pos = pos + 1
        }
    }
    send token_count
}

task generate(tokens) {
    asm = "module data\n"
    asm = asm + "    msg hello world\n"
    asm = asm + "\nmodule reserve\n"
    asm = asm + "    _stack 16384\n"
    asm = asm + "\nmodule code\n"
    asm = asm + "\n    fn global main\n"
    asm = asm + "    start\n"
    asm = asm + "        push sbp\n"
    asm = asm + "        move sbp stp\n"
    asm = asm + "        lma ret msg\n"
    asm = asm + "        move dst 1\n"
    asm = asm + "        move src ret\n"
    asm = asm + "        move dta 12\n"
    asm = asm + "        move ret 1\n"
    asm = asm + "        syscall\n"
    asm = asm + "        move ret 0\n"
    asm = asm + "        move stp sbp\n"
    asm = asm + "        pop sbp\n"
    asm = asm + "        return\n"
    asm = asm + "    end\n"
    asm = asm + "\n    fn global _start\n"
    asm = asm + "    start\n"
    asm = asm + "        call main\n"
    asm = asm + "        move ret 0\n"
    asm = asm + "        syscall\n"
    asm = asm + "    end\n"
    send asm
}
