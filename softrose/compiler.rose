# SoftRose compiler - written in SoftRose
# single-pass compiler: tokenizes and generates ThornASM

task start() {
    write("SoftRose v0.1\n")
    src = "task start write hello world end"
    len = 31
    asm = compile_src(src, len)
    write(asm)
    write("done\n")
}

task compile_src(src, len) {
    out = "module data\n    msg hello world\n\nmodule reserve\n    _stack 16384\n\nmodule code\n"
    pos = 0
    fn_count = 0
    loop(pos < len) {
        if (match_kw(src, pos, "task")) {
            pos = pos + 4
            pos = skip_ws(src, pos, len)
            ns = pos
            ne = word_end(src, pos, len)
            fname = sub(src, ns, ne)
            pos = ne
            pos = skip_ws(src, pos, len)
            params = ""
            if (pos < len && src[pos] == 40) {
                pos = pos + 1
                loop(pos < len && src[pos] != 41) {
                    if (src[pos] != 44 && src[pos] != 32) {
                        params = params + src[pos]
                    }
                    pos = pos + 1
                }
                pos = pos + 1
            }
            pos = skip_ws(src, pos, len)
            if (pos < len && src[pos] == 123) {
                pos = pos + 1
                bs = pos
                depth = 1
                loop(depth > 0 && pos < len) {
                    if (src[pos] == 123) { depth = depth + 1 }
                    if (src[pos] == 125) { depth = depth - 1 }
                    pos = pos + 1
                }
                be = pos - 1
                out = out + "\n    fn global " + fname + "\n    start\n        push sbp\n        move sbp stp\n"
                bp = bs
                loop(bp < be) {
                    out = out + compile_stmt(src, bp, be)
                    bp = next_stmt(src, bp, be)
                }
                out = out + "        move ret 0\n        move stp sbp\n        pop sbp\n        return\n    end\n"
                fn_count = fn_count + 1
            }
        } else {
            pos = pos + 1
        }
    }
    out = out + "\n    fn global _start\n    start\n        call start\n        move ret 0\n        syscall\n    end\n"
    send out
}

task compile_stmt(src, pos, be) {
    out = ""
    e = eol(src, pos, be)
    # write("string")
    if (match_kw(src, pos, "write(")) {
        p = pos + 6
        loop(p < e && src[p] != 34) { p = p + 1 }
        if (p < e) {
            p = p + 1
            ss = p
            loop(p < e && src[p] != 34) { p = p + 1 }
            sl = p - ss
            out = out + "        lma ret msg\n        move dst 1\n        move src ret\n        move dta " + num_str(sl) + "\n        move ret 1\n        syscall\n"
        }
        send out
    }
    # send expr
    if (match_kw(src, pos, "send ")) {
        out = out + "        move ret 0\n"
        send out
    }
    # variable = expr
    eq = find_ch(src, pos, e, 61)
    if (eq > pos && eq < e) {
        vn = sub(src, pos, eq)
        vs = eq + 1
        out = out + "        move ret " + sub(src, vs, e) + "\n"
        send out
    }
    send out
}

task next_stmt(src, pos, be) {
    loop(pos < be) {
        if (src[pos] == 10) { send pos + 1 }
        pos = pos + 1
    }
    send be
}

task eol(src, pos, be) {
    loop(pos < be) {
        if (src[pos] == 10) { send pos }
        pos = pos + 1
    }
    send be
}

task match_kw(src, pos, kw) {
    kl = slen(kw)
    i = 0
    ok = 1
    loop(i < kl) {
        if (pos + i >= 31) { ok = 0; break }
        if (src[pos + i] != kw[i]) { ok = 0; break }
        i = i + 1
    }
    send ok
}

task skip_ws(src, pos, len) {
    loop(pos < len) {
        ch = src[pos]
        if (ch == 32 || ch == 9 || ch == 10) { pos = pos + 1 } else { break }
    }
    send pos
}

task word_end(src, pos, len) {
    loop(pos < len) {
        ch = src[pos]
        if (ch == 32 || ch == 9 || ch == 10 || ch == 40 || ch == 123) { break }
        pos = pos + 1
    }
    send pos
}

task slen(s) {
    l = 0
    loop(s[l] != 0) { l = l + 1 }
    send l
}

task sub(s, a, b) {
    r = ""
    i = a
    loop(i < b) { r = r + s[i]; i = i + 1 }
    send r
}

task num_str(n) {
    if (n == 0) { send "0" }
    r = ""
    loop(n > 0) {
        d = n - (n / 10) * 10
        r = chr(48 + d) + r
        n = n / 10
    }
    send r
}

task find_ch(src, pos, e, target) {
    loop(pos < e) {
        if (src[pos] == target) { send pos }
        pos = pos + 1
    }
    send e
}

task chr(c) {
    s = ""
    if (c == 48) { s = "0" }
    if (c == 49) { s = "1" }
    if (c == 50) { s = "2" }
    if (c == 51) { s = "3" }
    if (c == 52) { s = "4" }
    if (c == 53) { s = "5" }
    if (c == 54) { s = "6" }
    if (c == 55) { s = "7" }
    if (c == 56) { s = "8" }
    if (c == 57) { s = "9" }
    send s
}
