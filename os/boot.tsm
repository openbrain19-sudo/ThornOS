origin 0x7C00

module code
    fn global _start
    start
        # print greeting using BIOS int 10h
        # string is embedded after this code
        move r1 0

    print_loop:
        # calculate string address: current position + offset to string
        # string is at a fixed position after the code
        move r2 0x7C00
        add r2 0x3E       # offset past BPB area
        add r2 r1         # + character index
        add r2 code_size  # + code size (will be patched)
        move.1 ret [r2]

        cmp ret == 0 go done

        move r3 ret
        move ret 0x0E
        move dst 0
        move dta 0x07
        move src r3
        int 0x10

        inc r1
        go print_loop

    done:
        hlt

    code_size:
